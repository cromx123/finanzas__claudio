# Postgres
POSTGRES_USER=finanzas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finanzas
DATABASE_URL=postgresql+psycopg://finanzas:change-me@postgres:5432/finanzas

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET=change-me-too
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Internal-only endpoints (e.g. POST /internal/refresh)
INTERNAL_API_SECRET=change-me-internal

# Ingestion
INGEST_TZ=America/Santiago
INGEST_CRON_SANTIAGO=05 17 * * 1-5
INGEST_CRON_NYSE=05 16 * * 1-5
FX_SOURCE=yahoo

# Frontend (apps/web) — base URL the browser uses to reach the API.
# Currently unused: the frontend still runs on mock data (see apps/web/lib/api/client.ts).
NEXT_PUBLIC_API_URL=http://localhost:8000
